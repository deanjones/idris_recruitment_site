---
layout: base.njk
title: Football
description: Idris Thomas-Jones – attacking midfielder (CAM / #10), Chippenham Town Academy. Honours, positions and coach testimonials.
permalink: /football/
---
{%- set feature = football.feature_image if (football.feature_image and football.feature_image.id) else null %}
<div class="page-layout{% if feature %} has-feature{% endif %}">
<div class="page-main">
<h1 class="page-title">Football</h1>

{%- if profile.positions_short %}
<section class="panel">
  <h2>Positions</h2>
  <p><b>{{ profile.positions_short }}</b></p>
</section>
{%- endif %}

{%- if football.achievements and football.achievements.length %}
<section class="panel">
  <h2>Achievements</h2>
  <ul class="timeline">
    {%- for a in football.achievements %}
    <li data-testid="achievement">
      <span class="season">{{ a.season }}</span>
      <span><b>{{ a.result }}</b> – {{ a.competition }}<br><span class="muted">{{ a.team }}</span></span>
    </li>
    {%- endfor %}
  </ul>
</section>
{%- endif %}

{%- if football.development and football.development.length %}
<section class="panel">
  <h2>Development</h2>
  <ul class="timeline">
    {%- for d in football.development %}
    <li data-testid="development"><span class="season">{{ d.years }}</span> <span>{{ d.name }}</span></li>
    {%- endfor %}
  </ul>
</section>
{%- endif %}

{%- if football.stats and football.stats.length %}
<section class="panel">
  <h2>Season stats</h2>
  <table class="data" data-testid="stats-table">
    <thead><tr><th>Season</th><th>Team</th><th>Apps</th><th>Goals</th><th>Assists</th></tr></thead>
    <tbody>
      {%- for s in football.stats %}
      <tr><td>{{ s.season }}</td><td>{{ s.team }}</td><td>{{ s.apps }}</td><td>{{ s.goals }}</td><td>{{ s.assists }}</td></tr>
      {%- endfor %}
    </tbody>
  </table>
</section>
{%- endif %}

{%- if testimonials.testimonials.length %}
<section class="panel" id="testimonials">
  <h2>What coaches say</h2>
  <div class="quote-list">
    {%- for t in testimonials.testimonials %}
      {%- set hide = false %}
      {% include "testimonial.njk" %}
    {%- endfor %}
  </div>
</section>
{%- endif %}

<p><a href="/media/">Watch highlights and full matches →</a></p>
</div>
{%- if feature %}
<aside class="page-feature" data-testid="feature-image">
  {%- set id = feature.id %}{% set alt = feature.alt %}{% set sizes = "300px" %}{% set style = "" %}
  {% include "photo.njk" %}
</aside>
{%- endif %}
</div>
