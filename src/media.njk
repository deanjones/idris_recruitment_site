---
layout: base.njk
title: Videos
description: Idris Thomas-Jones – highlight reel, full-match video and photos.
permalink: /media/
---
{%- if videos.banner and videos.banner.id %}
<figure class="banner" data-testid="banner">
  {%- set id = videos.banner.id %}{% set alt = videos.banner.alt %}{% set sizes = "(max-width: 960px) 100vw, 960px" %}
  {%- set style = "object-position: " + videos.banner.focus if videos.banner.focus else "" %}
  {% include "photo.njk" %}
</figure>
{%- endif %}
{%- set style = "" %}
<h1 class="page-title">Videos</h1>

{%- set highlight = (videos.highlight.url if videos.highlight else "") | parseVideo %}
{%- set matches = videos.matches or [] %}
{%- set photoList = photos.photos or [] %}

{%- if highlight.provider != "none" or matches.length %}
<section class="panel">
  <div class="video-grid">
    {%- if highlight.provider != "none" %}
    <article class="video-card">
      <h3>{{ videos.highlight.title or "Highlight reel" }}</h3>
      {%- if videos.highlight.details %}<p class="muted">{{ videos.highlight.details }}</p>{% endif %}
      {%- set v = highlight %}{% set title = videos.highlight.title or "Highlight reel" %}
      {% include "video.njk" %}
    </article>
    {%- endif %}
    {%- for m in matches %}
    {%- set v = m.url | parseVideo %}
    <article class="video-card">
      {%- if m.title %}<h3>{{ m.title }}</h3>{% endif %}
      {%- set meta = [m.competition, m.date] | select | join(" · ") %}
      {%- if meta %}<p class="muted">{{ meta }}</p>{% endif %}
      {%- if m.watch_for %}<p>Watch for: {{ m.watch_for }}</p>{% endif %}
      {%- set title = m.title or "Match video" %}
      {% include "video.njk" %}
    </article>
    {%- endfor %}
  </div>
</section>
{%- endif %}

{%- if photoList.length %}
<section class="panel">
  <h2>Photos</h2>
  <div class="photo-grid">
    {%- for p in photoList %}
    <figure data-testid="photo">
      {%- set id = p.id %}{% set alt = p.alt %}{% set sizes = "(max-width: 600px) 50vw, 300px" %}
      {% include "photo.njk" %}
      {%- if p.caption %}<figcaption>{{ p.caption }}</figcaption>{% endif %}
    </figure>
    {%- endfor %}
  </div>
</section>
{%- endif %}

{%- if highlight.provider == "none" and not matches.length and not photoList.length %}
<p class="muted">Videos coming soon.</p>
{%- endif %}
