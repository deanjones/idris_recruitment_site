---
layout: base.njk
title: Video & photos
description: Idris Thomas-Jones – highlight reel, full-match video and photos.
permalink: /media/
---
<h1 class="page-title">Video &amp; photos</h1>

{%- set highlight = (videos.highlight.url if videos.highlight else "") | parseVideo %}
{%- set matches = videos.matches or [] %}
{%- set photoList = photos.photos or [] %}

{%- if highlight.provider != "none" %}
<section class="panel">
  <h2>{{ videos.highlight.title or "Highlight reel" }}</h2>
  {%- set v = highlight %}{% set title = videos.highlight.title or "Highlight reel" %}
  {% include "video.njk" %}
</section>
{%- endif %}

{%- if matches.length %}
<section class="panel">
  <h2>Full matches</h2>
  <div class="match-list">
    {%- for m in matches %}
    {%- set v = m.url | parseVideo %}
    <article class="match">
      <h3>{{ m.title }}</h3>
      <p class="muted">{{ [m.competition, m.date] | select | join(" · ") }}</p>
      {%- if m.watch_for %}<p>Watch for: {{ m.watch_for }}</p>{% endif %}
      {%- set title = m.title %}
      {% include "video.njk" %}
    </article>
    {%- endfor %}
  </div>
</section>
{%- endif %}

{#- Photo grid is added with the photo pipeline. #}

{%- if highlight.provider == "none" and not matches.length and not photoList.length %}
<p class="muted">Video and photos coming soon.</p>
{%- endif %}
