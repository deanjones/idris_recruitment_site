<section class="profile-card" data-testid="profile-card">
  <div class="profile-top">
    <div class="headshot">
      {%- if profile.headshot %}
        {%- set id = profile.headshot %}{% set alt = "Idris Thomas-Jones" %}{% set sizes = "240px" %}
        {%- set style = ("transform: scale(" + profile.headshot_zoom + "); transform-origin: " + (profile.headshot_focus or "50% 50%") + ";") if profile.headshot_zoom else "" %}
        {% include "photo.njk" %}
      {%- else %}
        <div class="initials" data-testid="initials">{{ profile.initials }}</div>
      {%- endif %}
    </div>
    <div class="profile-id">
      <div class="eyebrow">{{ profile.class_of }}</div>
      <h1>{{ profile.name }}</h1>
      {%- if profile.positions_short %}<p class="positions">{{ profile.positions_short }}</p>
      {%- elif profile.positions and profile.positions.length %}<p class="positions">{{ profile.positions | join(" · ") }}</p>{% endif %}
      <p class="club">{{ profile.club }} · {{ profile.country }}</p>
      {%- if profile.height_weight %}<p data-testid="height-weight">{{ profile.height_weight }}</p>{% endif %}
      {%- if academics.gpa_equivalent %}
      <p class="gpa" data-testid="gpa"><b>{{ academics.gpa_equivalent }} GPA</b> (US equivalent)</p>
      {%- endif %}
      {%- if profile.attributes and profile.attributes.length %}
      <dl class="attributes">
        {%- for a in profile.attributes %}
        <div data-testid="attribute"><dt>{{ a.label }}</dt><dd>{{ a.value }}</dd></div>
        {%- endfor %}
      </dl>
      {%- endif %}
      <div class="actions">
        {%- set highlight = (profile.highlight_url or (videos.highlight.url if videos.highlight else "")) | parseVideo %}
        {%- if highlight.provider != "none" %}
        <a class="btn btn-primary" data-testid="highlights-btn" href="{{ highlight.href }}">▶ Highlights</a>
        {%- endif %}
        <a class="btn" data-testid="contact-btn" href="mailto:{{ profile.email }}">Contact</a>
      </div>
    </div>
  </div>
</section>
