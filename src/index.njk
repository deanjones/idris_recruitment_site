---
layout: base.njk
title: Attacking Midfielder · Class of 2027
description: Idris Thomas-Jones – attacking midfielder (CAM / #10), Chippenham Town Academy, Class of 2027. Recruiting profile for US college soccer.
---
{% include "profile-card.njk" %}

{%- set homeQuotes = (testimonials.testimonials or []) | selectattr("homepage") %}
{%- if homeQuotes.length %}
{#- Long quotes are shown in parts of up to two sentences, rotating in turn. #}
<div class="quote-strip" data-rotate>
  {%- set first = true %}
  {%- for q in homeQuotes %}
    {%- for part in q.quote | quoteParts %}
      {%- set t = { quote: part, coach: q.coach, source: q.source, placeholder: q.placeholder } %}
      {%- set hide = not first %}{% set first = false %}
      {% include "testimonial.njk" %}
    {%- endfor %}
  {%- endfor %}
</div>
{%- endif %}

{%- set tiles = [
  { section: "soccer", title: "Soccer", summary: football.summary },
  { section: "academics", title: "Academics", summary: academics.summary },
  { section: "media", title: "Videos", summary: videos.summary }
] %}
<div class="tiles">
  {%- for t in tiles %}
  <div class="tile" data-testid="tile" data-section="{{ t.section }}">
    <h2>{{ t.title }}</h2>
    {%- if t.summary is string %}
      {%- if t.summary %}<p>{{ t.summary }}</p>{% endif %}
    {%- elif t.summary and t.summary.length %}
    <ul class="tile-lines">
      {%- for line in t.summary %}<li>{{ line }}</li>{% endfor %}
    </ul>
    {%- endif %}
    <a class="more" href="/{{ t.section }}/">More →</a>
  </div>
  {%- endfor %}
</div>
